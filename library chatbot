# School Library Chatbot

books = [
    {
        "title": "The Alchemist",
        "author": "Paulo Coelho",
        "category": "Fiction",
        "available": True
    },
    {
        "title": "Harry Potter",
        "author": "J.K. Rowling",
        "category": "Fantasy",
        "available": True
    },
    {
        "title": "Wings of Fire",
        "author": "A.P.J. Abdul Kalam",
        "category": "Biography",
        "available": False
    },
    {
        "title": "Python Programming",
        "author": "Mark Lutz",
        "category": "Programming",
        "available": True
    },
    {
        "title": "The Jungle Book",
        "author": "Rudyard Kipling",
        "category": "Adventure",
        "available": True
    }
]


def show_books():
    print("\nAvailable Books:")
    found = False

    for book in books:
        if book["available"]:
            print("-", book["title"], "by", book["author"])
            found = True

    if not found:
        print("No books are currently available.")


def search_book(name):
    for book in books:
        if name.lower() in book["title"].lower():
            print("\nBook Found!")
            print("Title:", book["title"])
            print("Author:", book["author"])
            print("Category:", book["category"])

            if book["available"]:
                print("Availability: Available")
            else:
                print("Availability: Not Available")

            return

    print("\nSorry, that book is not available in the library.")


def search_author(name):
    found = False

    print("\nBooks by", name + ":")

    for book in books:
        if name.lower() in book["author"].lower():
            print("-", book["title"])
            found = True

    if not found:
        print("No books found by this author.")


def search_category(category):
    found = False

    print("\nBooks in", category, "category:")

    for book in books:
        if category.lower() in book["category"].lower():
            print("-", book["title"], "by", book["author"])
            found = True

    if not found:
        print("No books found in this category.")


def borrow_book(name):
    for book in books:
        if name.lower() in book["title"].lower():

            if book["available"]:
                book["available"] = False
                print("\nYou have successfully borrowed:", book["title"])
            else:
                print("\nSorry, this book is already borrowed.")

            return

    print("\nBook not found.")


def return_book(name):
    for book in books:
        if name.lower() in book["title"].lower():

            if not book["available"]:
                book["available"] = True
                print("\nYou have successfully returned:", book["title"])
            else:
                print("\nThis book was not borrowed.")

            return

    print("\nBook not found.")


# Chatbot
print("=" * 45)
print("        SCHOOL LIBRARY CHATBOT")
print("=" * 45)

print("\nBot: Hello! Welcome to the School Library.")
print("Bot: I can help you find books and library information.")
print("Bot: Type 'help' to see what I can do.")
print("Bot: Type 'bye' to exit.")

while True:

    user = input("\nYou: ").strip()

    if user.lower() == "bye":
        print("\nBot: Thank you for using the School Library Chatbot!")
        print("Bot: Have a great day! 📚")
        break

    elif user.lower() == "help":
        print("\nBot: You can ask me:")
        print("- Show available books")
        print("- Search for a book")
        print("- Find books by an author")
        print("- Find books by category")
        print("- Borrow a book")
        print("- Return a book")
        print("- Bye")

    elif "available books" in user.lower() or "list books" in user.lower():
        show_books()

    elif user.lower().startswith("search book"):
        name = user[11:].strip()

        if name:
            search_book(name)
        else:
            name = input("Bot: Enter the book name: ")
            search_book(name)

    elif user.lower().startswith("find author"):
        name = user[11:].strip()

        if name:
            search_author(name)
        else:
            name = input("Bot: Enter the author's name: ")
            search_author(name)

    elif user.lower().startswith("find category"):
        category = user[13:].strip()

        if category:
            search_category(category)
        else:
            category = input("Bot: Enter the category: ")
            search_category(category)

    elif user.lower().startswith("borrow"):
        name = user[6:].strip()

        if name:
            borrow_book(name)
        else:
            name = input("Bot: Enter the book you want to borrow: ")
            borrow_book(name)

    elif user.lower().startswith("return"):
        name = user[6:].strip()

        if name:
            return_book(name)
        else:
            name = input("Bot: Enter the book you want to return: ")
            return_book(name)

    elif "hello" in user.lower() or "hi" in user.lower():
        print("Bot: Hello! How can I help you with the library?")

    elif "author" in user.lower():
        print("Bot: Please use 'find author' followed by the author's name.")

    elif "category" in user.lower():
        print("Bot: Please use 'find category' followed by the category name.")

    else:
        # Try searching for the entered text as a book name
        found = False

        for book in books:
            if user.lower() in book["title"].lower():
                search_book(user)
                found = True
                break

        if not found:
            print("\nBot: Sorry, I don't understand that question.")
            print("Bot: Type 'help' to see what I can do.")